<%
const currentYear = new Date().getFullYear();
const nextYear = currentYear + 1;
const session = `${currentYear}/${nextYear}`;

const pageTitle = `UNN Course Registration Guide ${session} – Step-by-Step Portal Tutorial`;
const pageDescription = `Complete guide on how to register courses online at the University of Nigeria, Nsukka (UNN) for the ${session} academic session. Includes portal login, unit limits, and departmental approval steps.`;
const pageKeywords = `UNN course registration, UNN student portal, UNN course form ${session}, University of Nigeria Nsukka, UNN course registration deadline, UNN credit load limit`;
const pageUrl = `https://mysearch-query.onrender.com/unn-reg/courses`;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ===================== PRIMARY SEO ===================== -->
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>" />
  <meta name="keywords" content="<%= pageKeywords %>" />
  <meta name="author" content="UC Tech Hub" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="<%= pageUrl %>" />

  <!-- ===================== OPEN GRAPH ===================== -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="UC Tech Hub" />
  <meta property="og:title" content="UNN Online Course Registration Guide <%= session %>" />
  <meta property="og:description" content="<%= pageDescription %>" />
  <meta property="og:url" content="<%= pageUrl %>" />
  <meta property="og:image" content="https://mysearch-query.onrender.com/images/logo.jpg" />

  <!-- ===================== TWITTER CARD ===================== -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="UNN Course Registration Guide <%= session %>" />
  <meta name="twitter:description" content="<%= pageDescription %>" />
  <meta name="twitter:image" content="https://mysearch-query.onrender.com/images/logo.jpg" />

  <link rel="icon" href="/images/logo.jpg" type="image/jpeg" />

  <!-- ===================== STRUCTURED DATA ===================== -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Register Courses Online at University of Nigeria, Nsukka (UNN)",
    "description": "Step-by-step instructions for completing online course registration on the UNN student portal.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Log in to the UNN Student Portal",
        "text": "Visit unnportal.unn.edu.ng and log in using your Matriculation Number or JAMB Registration Number and password."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Navigate to Course Registration",
        "text": "Go to the Course Registration section on your dashboard and select the active academic session and semester."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Select Your Courses",
        "text": "Select all mandatory core courses and required electives ensuring you do not exceed maximum credit limits."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Submit and Print Course Form",
        "text": "Submit the online form and print copies of your generated course slip."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "Obtain Departmental Approval",
        "text": "Submit the printed course forms to your Head of Department (HOD) or Academic Adviser for official endorsement."
      }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mysearch-query.onrender.com/" },
      { "@type": "ListItem", "position": 2, "name": "UNN Guides", "item": "https://mysearch-query.onrender.com/unn-jamb/courses/programs" },
      { "@type": "ListItem", "position": 3, "name": "Course Registration", "item": "<%= pageUrl %>" }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <%- include('../includeFolder/_headers.ejs') %>
</head>
<body>

  <a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>

  <!-- ===================== HEADER ===================== -->
  <header class="nav-header" id="scrollHeader">
    <div class="logo"><img src="/images/logo.jpg" alt="UC Tech Hub logo"></div>
    <div class="menu-toggle" onclick="toggleMenu()" role="button" aria-label="Toggle navigation" tabindex="0">☰</div>
    <ul class="header-nav-links" id="navLinks">
      <li><a href="/">Home</a></li>
      <li><a href="/nigeria/list-of-institution/page">Universities</a></li>
      <li><a href="/calculate/cgpa/app">CGPA Calculator</a></li>
      <li><a href="/calculate/jamb-aggregate/app">Aggregate Calculator</a></li>
      <li><a href="/check/course-eligibility/app">Eligibility Checker</a></li>
      <li class="contact-link"><a href="/contact-us/page">Contact Us</a></li>
    </ul>
  </header>
  <script>
    function toggleMenu() { document.getElementById('navLinks').classList.toggle('active'); }
  </script>

  <main id="main-content">
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <a href="/">Home</a> &rsaquo;
      <a href="/nigeria/list-of-institution/page">UNN Guides</a> &rsaquo;
      <span>Course Registration</span>
    </nav>

    <section class="hero">
      <h1>UNN Online Course Registration Guide (<%= session %>)</h1>
      <p>University of Nigeria, Nsukka &middot; Portal Guidelines & Step-by-Step Instructions</p>
    </section>

    <div class="container">
      <div class="section-txt">
        <h2>Step-by-Step Course Registration Process</h2>
        <p>Follow these official instructions to successfully submit your course form on the UNN portal for the <%= session %> academic session:</p>

        <ul class="child-ul">
          <li>
            <strong>Step 1: Log in to the UNN Portal</strong><br>
            Visit the <a href="https://unnportal.unn.edu.ng" target="_blank" rel="noopener">UNN Student Portal</a>. Click on <strong>Student Login</strong>, enter your Registration/Matriculation Number and Password, then click <strong>Login</strong>.
          </li>
          <li>
            <strong>Step 2: Navigate to Course Registration</strong><br>
            On your user dashboard, locate and click the <strong>Course Registration</strong> tab. Select the active <strong><%= session %></strong> session and the current semester.
          </li>
          <li>
            <strong>Step 3: Course Selection & Unit Calculation</strong><br>
            Carefully tick all required departmental core courses and elective options. Verify that your total selected credit load does not exceed the departmental maximum threshold.
          </li>
          <li>
            <strong>Step 4: Form Submission & Printing</strong><br>
            Review all selected course codes for accuracy before clicking <strong>Submit</strong>. Once submitted, print out at least four (4) hard copies of the generated Course Registration Slip.
          </li>
          <li>
            <strong>Step 5: Academic Adviser & HOD Approval</strong><br>
            Take your printed slips to your Departmental Course Adviser and Head of Department (HOD) for verification, sign-off, and official stamping.
          </li>
        </ul>
      </div>
           <%- include('../includeFolder/_jamb_2.ejs') %>


      <div class="section-txt">
        <h2>Important Course Registration Guidelines</h2>
        <ul class="child-ul">
          <li><strong>Deadline Compliance:</strong> Complete registration and physical submission before the official portal closure deadline to avoid late registration fines or carryover penalties.</li>
          <li><strong>Credit Limit Regulations:</strong> Ensure your registered credit units stay within the minimum and maximum boundaries set by your faculty.</li>
          <li><strong>Form Corrections:</strong> Course adjustments or modifications can only be processed prior to final signature endorsement by your HOD.</li>
        </ul>
      </div>

      <div class="section-txt">
        <h2>Useful Portal Links</h2>
        <div class="cta-row">
          <a class="cta-button" href="https://unnportal.unn.edu.ng" target="_blank" rel="noopener">UNN Student Portal</a>
          <a class="cta-button" href="https://www.unn.edu.ng" target="_blank" rel="noopener">UNN Official Website</a>
          <a class="cta-button" href="/calculate/cgpa/app">CGPA Calculator</a>
          <a class="cta-button" href="/check/course-eligibility/app">Eligibility Checker</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../includeFolder/jambHot_link6.ejs') %>
  <script src="/js/index.js"></script>
  <%- include('../includeFolder/_footer.ejs') %>

</body>
</html>