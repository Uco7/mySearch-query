<%
const currentYear = new Date().getFullYear();
const nextYear = currentYear + 1;
const session = `${currentYear}/${nextYear}`;

const pageTitle = `UNN School Fees Schedule & Scholarships ${session} - University of Nigeria Nsukka`;
const pageDescription = `Complete breakdown of UNN tuition fees, hostel accommodation costs, payment deadlines, and student loan options for the ${session} academic session.`;
const pageKeywords = `UNN fees ${session}, UNN tuition schedule, UNN scholarships, University of Nigeria Nsukka fees, UNN freshers school fees`;
const pageUrl = `https://mysearch-query.onrender.com/unn-fees`;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ===================== PRIMARY SEO ===================== -->
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>" />
  <meta name="keywords" content="<%= pageKeywords %>" />
  <meta name="author" content="UC Tech Hub" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="<%= pageUrl %>" />

  <!-- ===================== OPEN GRAPH ===================== -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="UC Tech Hub" />
  <meta property="og:title" content="UNN School Fees & Financial Aid <%= session %>" />
  <meta property="og:description" content="<%= pageDescription %>" />
  <meta property="og:url" content="<%= pageUrl %>" />
  <meta property="og:image" content="https://mysearch-query.onrender.com/images/logo.jpg" />

  <!-- ===================== TWITTER CARD ===================== -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="UNN School Fees & Financial Aid <%= session %>" />
  <meta name="twitter:description" content="<%= pageDescription %>" />
  <meta name="twitter:image" content="https://mysearch-query.onrender.com/images/logo.jpg" />

  <link rel="icon" href="/images/logo.jpg" type="image/jpeg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <%- include('../includeFolder/_headers.ejs') %>
</head>
<body>

  <a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>

  <!-- ===================== HEADER ===================== -->
  <header class="nav-header" id="scrollHeader">
    <div class="logo"><img src="/images/logo.jpg" alt="UC Tech Hub logo"></div>
    <div class="menu-toggle" onclick="toggleMenu()" role="button" aria-label="Toggle navigation" tabindex="0">☰</div>
    <ul class="header-nav-links" id="navLinks">
      <li><a href="/">Home</a></li>
      <li><a href="/nigeria/list-of-institution/page">Universities</a></li>
      <li><a href="/calculate/cgpa/app">CGPA Calculator</a></li>
      <li><a href="/calculate/jamb-aggregate/app">Aggregate Calculator</a></li>
      <li><a href="/check/course-eligibility/app">Eligibility Checker</a></li>
      <li class="contact-link"><a href="/contact-us/page">Contact Us</a></li>
    </ul>
  </header>
  <script>
    function toggleMenu() { document.getElementById('navLinks').classList.toggle('active'); }
  </script>

  <main id="main-content">
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <a href="/">Home</a> &rsaquo;
      <a href="/nigeria/list-of-institution/page">UNN Guides</a> &rsaquo;
      <span>Fees & Scholarships</span>
    </nav>

    <section class="hero">
      <h1>UNN Fees & Scholarship Options (<%= session %>)</h1>
      <p>University of Nigeria, Nsukka &middot; Financial Information</p>
    </section>

    <div class="container">
      <div class="section-txt">
        <h2>Tuition & Fee Structure (Fresh Students)</h2>
        <ul class="child-ul">
          <li><strong>Acceptance Fee:</strong> ₦20,000 – ₦30,000 (Non-refundable)</li>
          <li><strong>Tuition Charges:</strong> ₦70,000 – ₦80,000 (Varies by faculty)</li>
          <li><strong>Development Levy:</strong> ₦20,000</li>
          <li><strong>Medical Registration:</strong> ₦10,000</li>
          <li><strong>ICT & Library Dues:</strong> ₦10,500</li>
          <li><strong>Estimated Total:</strong> ₦140,000 – ₦170,000</li>
        </ul>
      </div>
           <%- include('../includeFolder/_jamb_2.ejs') %>


      <div class="section-txt">
        <h2>Scholarships & Financial Aid</h2>
        <p>Students can explore Federal Government Scholarships, corporate awards (e.g. NNPCL/Chevron), and institutional merit awards.</p>
        <p>Visit the official <a href="https://unn.edu.ng" target="_blank" rel="noopener">UNN Portal</a> for scholarship notices.</p>
      </div>

      <div class="section-txt">
        <h2>Student Loans (NELFUND)</h2>
        <p>Nigerian students can apply for interest-free educational support via the <a href="https://www.nelf.gov.ng/" target="_blank" rel="noopener">National Education Loan Fund (NELFUND) Portal</a>.</p>
      </div>

      <div class="section-txt">
        <h2>Useful Links</h2>
        <div class="cta-row">
          <a class="cta-button" href="https://unnportal.unn.edu.ng" target="_blank" rel="noopener">UNN Student Portal</a>
          <a class="cta-button" href="/calculate/cgpa/app">CGPA Calculator</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../includeFolder/jambHot_link6.ejs') %>
  <script src="/js/index.js"></script>
  <%- include('../includeFolder/_footer.ejs') %>

</body>
</html>