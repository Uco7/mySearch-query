<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>JAMB <%= year %>: CBT Exam Date, Accredited Centres & Registration Requirements</title>

  <!-- ✅ Advanced SEO Meta Tags -->
  <meta name="description" content="Get updated details on JAMB <%= year %> CBT exam dates, accredited registration centres, and complete requirements for a successful application.">
  <meta name="keywords" content="JAMB <%= year %>, JAMB exam date <%= year %>, JAMB centres <%= year %>, JAMB registration requirements, CBT exam <%= year %>">
