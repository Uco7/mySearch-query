<% 
  const year = typeof currentYear !== 'undefined' ? currentYear : (typeof seo !== 'undefined' && seo.year ? seo.year : new Date().getFullYear());
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholarships for Nigerian University Students (<%= year %> Guide)</title>

    <!-- ✅ Advanced SEO Meta Tags -->
    <meta name="description" content="Explore verified undergraduate and postgraduate scholarships for Nigerian university students in <%= year %>. Get application links for government, PTDF, MTN, and corporate grants.">
    <meta name="keywords" content="scholarships for Nigerian students <%= year %>, Nigerian university scholarships, federal government scholarship, PTDF, MTN foundation, Agbami scholarship">
    <meta name="author" content="MySchoolGist">
    <link rel="canonical" href="https://mysearch-query.onrender.com/scholarship/guid">

    <meta property="og:title" content="Scholarships for Nigerian University Students (<%= year %>)">
    <meta property="og:description" content="Discover verified scholarships available for Nigerian students with official application links.">
    <meta property="og:url" content="https://mysearch-query.onrender.com/scholarship/guid">
    <meta property="og:type" content="article">

    <%- include('../includeFolder/_headers.ejs') %>
</head>
<body>
   <%- include('../includeFolder/hot_link_1.ejs') %>

    <div class="heading-top">
      <h1>Scholarships for Nigerian University Students (<%= year %>)</h1>
      <p>Here is a compiled list of active government, corporate, and international scholarship opportunities for Nigerian students:</p>
    </div>

    <div class="container">
        <h2>1. Federal Government Scholarships</h2>
        <ul>
            <li>For undergraduate and postgraduate students in tertiary institutions. <br>
                <a href="https://fsbn.com.ng/" target="_blank">Apply Here</a>
            </li>
        </ul>

        <h2>2. PTDF (Petroleum Technology Development Fund) Scholarship</h2>
        <ul>
            <li>For undergraduate and postgraduate students in energy and engineering fields. <br>
                <a href="https://ptdf.gov.ng/scholarship/" target="_blank">Apply Here</a>
            </li>
        </ul>

        <h2>3. MTN Foundation Scholarship</h2>
        <ul>
            <li>For high-performing 300-level STEM students in accredited Nigerian universities. <br>
                <a href="https://www.mtn.ng/scholarships/" target="_blank">Apply Here</a>
            </li>
        </ul>

        <h2>4. Seplat JV Scholarship</h2>
        <ul>
            <li>Open to undergraduate students in federal and state universities. <br>
                <a href="https://seplatscholarship.com/" target="_blank">Apply Here</a>
            </li>
        </ul>
    </div>

  <%- include('../includeFolder/_admission_queryLink.ejs') %>
  <%- include('../includeFolder/jambHot_link6.ejs') %>
  <script src="js/index.js"></script>
  <%- include('../includeFolder/_footer.ejs') %>
</body>
</html>