  <meta name="keywords" content="FUNAI, postgraduate programs, scholarships, university admissions, postgraduate application, FUNAI scholarships">
  <meta name="author" content="FUNAI University">

  <!-- Open Graph -->
  <meta property="og:title" content="Apply for Postgraduate Programs at FUNAI">
  <meta property="og:description" content="Apply for postgraduate programs at FUNAI. Explore the application process, scholarship opportunities, and more.">
