<body>

  <header class="heading-top">
    <h1>FUNAI Admission Deadlines & Process</h1>
    <p>Comprehensive overview of key dates, registration steps, and application procedures.</p>
  </header>

  <div class="container my-5">
    <!-- General Queries Section -->
    <%- include('../includeFolder/_admission_queryLink.ejs') %>
